{
    "builderLimit": {
        "maxBuildTime": "15m",
        "cpusetCpus": "0-3",
        "memory": "4096m"
    },
    "packages": [
        {
            "enabled": true,
            "packageName": "anki-bin"
        },
        {
            "enabled": true,
            "packageName": "osu-lazer-bin",
            "resolveDependenciesAs": {
                "libgl": "libglvnd"
            }
        },
        {
            "enabled": true,
            "packageName": "spotify",
            "runCommandsBeforeBuild": [
                "curl -sS https://download.spotify.com/debian/pubkey_C85668DF69375001.gpg  | gpg --import -"
            ]
        },
        {
            "enabled": false,
            "packageName": "proton-pass-bin",
            "enforceCustomPackage": true
        }
    ]
}
